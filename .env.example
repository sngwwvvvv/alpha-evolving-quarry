# Hermes agent profiles (openrouter provider)
# Rule: one isolated profile = one .env = one key. Never share across profiles.
# Copy this file into each profile's home directory and fill in a distinct key.

# Required by all four profiles: orchestrator, research, coding, analysis-ledger
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Pinned logical models (informational; enforced in code, not configurable here)
#   orchestrator      deepseek/deepseek-v4-pro-0813
#   research          deepseek/deepseek-v4-pro-0813
#   coding            deepseek/deepseek-v4-flash-0731
#   analysis-ledger   deepseek/deepseek-v4-flash-0731

# Trading core needs no env vars: SQLite path and artifact root are Settings defaults
# (state/trading_desk.sqlite3, artifacts/). Paper feeds use FakeClock/FakeRestClient,
# so no Binance keys belong in any environment.
